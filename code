# Voltage-Protector-fsmb-phase-1
built a voltage protector on a small prototype board
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Preferences.h>
#include <math.h>

// ---------- Pins ----------
const int PIN_V = 34;
const int PIN_I = 35;

const int PIN_RELAY = 26;

const int PIN_UP  = 32;
const int PIN_DN  = 33;
const int PIN_SEL = 14;

// Status LEDs
const int PIN_LED_GREEN  = 18;
const int PIN_LED_RED    = 19;
const int PIN_LED_YELLOW = 21;

LiquidCrystal_I2C lcd(0x27, 16, 2);
Preferences prefs;

// ---------- Protection settings ----------
float ovLimit = 240.0;
float ocLimit = 4.0;

unsigned long tripDelay = 300;
unsigned long reconDelay = 10000;

// ---------- State ----------
// 0 = normal, 1 = fault, 2 = cooldown
int state = 2;

bool pending = false;
unsigned long pendingStart = 0;
unsigned long coolStart = 0;

unsigned int tripCount = 0;

const char* faultText = "NONE";

float v = 0.0;
float i = 0.0;

// ---------- Menu ----------
bool menuOn = false;
int menuIdx = 0;
unsigned long lastPress = 0;

const char* menuName[4] = {
  "OV limit",
  "OC limit",
  "Trip delay",
  "Recon delay"
};

// ---------- Settings storage ----------
void saveSettings() {
  prefs.putFloat("ov", ovLimit);
  prefs.putFloat("oc", ocLimit);
  prefs.putULong("td", tripDelay);
  prefs.putULong("rd", reconDelay);
}

void loadSettings() {
  ovLimit = prefs.getFloat("ov", 250.0);
  ocLimit = prefs.getFloat("oc", 6.0);
  tripDelay = prefs.getULong("td", 500);
  reconDelay = prefs.getULong("rd", 5000);

  if (!isfinite(ovLimit) ||
      ovLimit < 100 || ovLimit > 300) {
    ovLimit = 250.0;
  }

  if (!isfinite(ocLimit) ||
      ocLimit < 0.5 || ocLimit > 10) {
    ocLimit = 6.0;
  }

  if (tripDelay > 5000) {
    tripDelay = 500;
  }

  if (reconDelay < 1000 ||
      reconDelay > 60000) {
    reconDelay = 5000;
  }
}

bool setValue(int k, float val) {
  if (!isfinite(val)) return false;

  if (k == 0 && val >= 100 && val <= 300) {
    ovLimit = val;
  }
  else if (k == 1 && val >= 0.5 && val <= 10) {
    ocLimit = val;
  }
  else if (k == 2 && val >= 0 && val <= 5000) {
    tripDelay = (unsigned long)val;
  }
  else if (k == 3 && val >= 1000 && val <= 60000) {
    reconDelay = (unsigned long)val;
  }
  else {
    return false;
  }

  return true;
}

float getValue(int k) {
  if (k == 0) return ovLimit;
  if (k == 1) return ocLimit;
  if (k == 2) return (float)tripDelay;
  return (float)reconDelay;
}

void printSettings() {
  Serial.printf(
    "OV=%.1f V  OC=%.2f A  DELAY=%lu ms  RECON=%lu ms\n",
    ovLimit, ocLimit, tripDelay, reconDelay
  );
}

// ---------- LED status ----------
void updateLEDs() {
  // Green = normal
  // Red flashing = fault
  // Yellow = cooldown

  digitalWrite(PIN_LED_GREEN, LOW);
  digitalWrite(PIN_LED_RED, LOW);
  digitalWrite(PIN_LED_YELLOW, LOW);

  if (state == 0) {
    digitalWrite(PIN_LED_GREEN, HIGH);
  }
  else if (state == 1) {
    digitalWrite(
      PIN_LED_RED,
      ((millis() / 300) % 2) ? HIGH : LOW
    );
  }
  else {
    digitalWrite(PIN_LED_YELLOW, HIGH);
  }
}

// ---------- Sensors ----------
void readSensors() {
  static unsigned long last = 0;
  unsigned long now = millis();

  if (now - last < 10) return;
  last = now;

  // Example conversions. Calibrate for your actual sensors.
  float newV = analogRead(PIN_V) * 300.0 / 4095.0;
  float newI = analogRead(PIN_I) * 10.0 / 4095.0;

  // Low-pass filtering
  v = 0.8 * v + 0.2 * newV;
  i = 0.8 * i + 0.2 * newI;
}

// ---------- Protection ----------
bool readingsSafe() {
  return v < ovLimit - 5.0 &&
         i < ocLimit - 0.3;
}

void trip() {
  // Disconnect load first
  digitalWrite(PIN_RELAY, LOW);

  state = 1;
  pending = false;
  tripCount++;

  Serial.printf(
    "[%lu ms] TRIP: %s V=%.1f V I=%.2f A\n",
    millis(), faultText, v, i
  );
}

void protection() {
  unsigned long now = millis();

  bool overV = v > ovLimit;
  bool overI = i > ocLimit;

  if (state == 0) {
    // NORMAL
    if (overV || overI) {
      if (!pending) {
        pending = true;
        pendingStart = now;
      }

      faultText = overV
        ? "OVER-VOLTAGE"
        : "OVER-CURRENT";

      if (now - pendingStart >= tripDelay) {
        trip();
      }
    }
    else {
      pending = false;
    }
  }
  else if (state == 1) {
    // FAULT: wait until readings become safe
    if (readingsSafe()) {
      state = 2;
      coolStart = now;

      Serial.printf(
        "[%lu ms] Fault cleared; cooldown started\n",
        now
      );
    }
  }
  else {
    // COOLDOWN
    if (!readingsSafe()) {
      state = 1;

      Serial.printf(
        "[%lu ms] Fault returned; relay remains OFF\n",
        now
      );
    }
    else if (now - coolStart >= reconDelay) {
      if (readingsSafe()) {
        state = 0;
        pending = false;
        faultText = "NONE";

        digitalWrite(PIN_RELAY, HIGH);

        Serial.printf(
          "[%lu ms] Load reconnected\n",
          now
        );
      }
    }
  }
}

// ---------- Buttons and menu ----------
void pressed(int b) {
  lastPress = millis();

  if (b == 2) {
    if (!menuOn) {
      menuOn = true;
      menuIdx = 0;
    }
    else {
      menuIdx++;

      if (menuIdx > 3) {
        menuOn = false;
        saveSettings();
        Serial.println("Menu closed; settings saved");
      }
    }
  }
  else if (menuOn) {
    const float steps[4] = {
      5.0, 0.5, 100.0, 500.0
    };

    float change =
      (b == 0) ? steps[menuIdx] : -steps[menuIdx];

    setValue(menuIdx, getValue(menuIdx) + change);
  }
}

void buttons() {
  static unsigned long lastCheck = 0;
  static bool wasDown[3] = {
    false, false, false
  };

  const int pins[3] = {
    PIN_UP, PIN_DN, PIN_SEL
  };

  if (millis() - lastCheck < 40) return;
  lastCheck = millis();

  for (int b = 0; b < 3; b++) {
    bool down = (digitalRead(pins[b]) == LOW);

    if (down && !wasDown[b]) {
      pressed(b);
    }

    wasDown[b] = down;
  }

  if (menuOn && millis() - lastPress > 10000) {
    menuOn = false;
    saveSettings();

    Serial.println("Menu timeout; settings saved");
  }
}

// ---------- LCD display ----------
void showDisplay() {
  static unsigned long last = 0;

  if (millis() - last < 200) return;
  last = millis();

  lcd.setCursor(0, 0);

  if (menuOn) {
    lcd.printf("%-16s", menuName[menuIdx]);

    lcd.setCursor(0, 1);
    lcd.printf("%-10.1f UP/DN", getValue(menuIdx));
  }
  else {
    lcd.printf("V:%5.1f I:%4.2f  ", v, i);

    lcd.setCursor(0, 1);

    if (state == 0) {
      lcd.printf("%-16s", "NORMAL");
    }
    else if (state == 1) {
      lcd.printf("%-16s", faultText);
    }
    else {
      lcd.printf("%-16s", "COOLDOWN");
    }
  }
}

// ---------- Serial commands ----------
void printHelp() {
  Serial.println();
  Serial.println("===== VOLTAGE PROTECTOR COMMANDS =====");
  Serial.println("HELP                 - Show commands");
  Serial.println("STATUS               - Show system status");
  Serial.println("GET                  - Show protection settings");
  Serial.println("SET OV <value>       - Set overvoltage limit (100-300 V)");
  Serial.println("SET OC <value>       - Set overcurrent limit (0.5-10 A)");
  Serial.println("SET DELAY <value>    - Set trip delay (0-5000 ms)");
  Serial.println("SET RECON <value>    - Set cooldown (1000-60000 ms)");
  Serial.println("RESET                - Clear trip count and restart cooldown");
  Serial.println("REBOOT               - Restart ESP32");
  Serial.println("=====================================");
  Serial.println();
}

void printStatus() {
  const char* names[3] = {
    "NORMAL", "FAULT", "COOLDOWN"
  };

  Serial.printf(
    "State=%s V=%.1f V I=%.2f A Relay=%s\n",
    names[state], v, i,
    digitalRead(PIN_RELAY) ? "ON" : "OFF"
  );

  Serial.printf(
    "LastFault=%s Trips=%u Pending=%s\n",
    faultText, tripCount,
    pending ? "YES" : "NO"
  );

  if (pending) {
    Serial.printf(
      "FaultElapsed=%lu ms TripDelay=%lu ms\n",
      millis() - pendingStart, tripDelay
    );
  }

  if (state == 2) {
    Serial.printf(
      "CooldownElapsed=%lu ms CooldownRequired=%lu ms\n",
      millis() - coolStart, reconDelay
    );
  }
}

bool validNumber(String s) {
  s.trim();

  if (s.length() == 0) return false;

  bool digitSeen = false;
  bool dotSeen = false;

  for (unsigned int n = 0; n < s.length(); n++) {
    char c = s.charAt(n);

    if (c >= '0' && c <= '9') {
      digitSeen = true;
    }
    else if (c == '.' && !dotSeen) {
      dotSeen = true;
    }
    else if ((c == '-' || c == '+') && n == 0) {
      // Optional leading sign
    }
    else {
      return false;
    }
  }

  return digitSeen;
}

void resetProtection() {
  if (!readingsSafe()) {
    Serial.println(
      "ERR RESET denied: voltage/current not safe"
    );
    return;
  }

  digitalWrite(PIN_RELAY, LOW);

  tripCount = 0;
  pending = false;
  faultText = "NONE";

  state = 2;
  coolStart = millis();

  Serial.println(
    "OK RESET: trip count cleared; cooldown restarted"
  );
  Serial.println(
    "Relay remains OFF until cooldown expires"
  );
}

void handleCommand(String cmd) {
  cmd.trim();
  cmd.toUpperCase();

  if (cmd.length() == 0) return;

  if (cmd == "HELP") {
    printHelp();
  }
  else if (cmd == "STATUS") {
    printStatus();
  }
  else if (cmd == "GET") {
    printSettings();
  }
  else if (cmd == "RESET") {
    resetProtection();
  }
  else if (cmd == "REBOOT") {
    Serial.println("Rebooting...");
    Serial.flush();
    delay(100);
    ESP.restart();
  }
  else if (cmd.startsWith("SET ")) {
    int space = cmd.indexOf(' ', 4);

    if (space < 0) {
      Serial.println(
        "ERR usage: SET <OV|OC|DELAY|RECON> <value>"
      );
      return;
    }

    String name = cmd.substring(4, space);
    String valueText = cmd.substring(space + 1);
    valueText.trim();

    if (!validNumber(valueText)) {
      Serial.println("ERR invalid numeric value");
      return;
    }

    float val = valueText.toFloat();
    int k = -1;

    if (name == "OV") k = 0;
    else if (name == "OC") k = 1;
    else if (name == "DELAY") k = 2;
    else if (name == "RECON") k = 3;

    if (k >= 0 && setValue(k, val)) {
      saveSettings();
      Serial.print("OK Settings saved: ");
      printSettings();
    }
    else {
      Serial.println(
        "ERR invalid setting or out-of-range value"
      );
    }
  }
  else {
    Serial.println("ERR unknown command; type HELP");
  }
}

void readSerial() {
  static String line = "";

  while (Serial.available()) {
    char c = Serial.read();

    if (c == '\n' || c == '\r') {
      if (line.length() > 0) {
        handleCommand(line);
        line = "";
      }
    }
    else if (line.length() < 100) {
      line += c;
    }
    else {
      line = "";
      Serial.println("ERR command too long");
    }
  }
}

// ---------- Setup ----------
void setup() {
  Serial.begin(115200);

  // Relay OFF at startup
  pinMode(PIN_RELAY, OUTPUT);
  digitalWrite(PIN_RELAY, LOW);

  // LEDs
  pinMode(PIN_LED_GREEN, OUTPUT);
  pinMode(PIN_LED_RED, OUTPUT);
  pinMode(PIN_LED_YELLOW, OUTPUT);

  digitalWrite(PIN_LED_GREEN, LOW);
  digitalWrite(PIN_LED_RED, LOW);
  digitalWrite(PIN_LED_YELLOW, LOW);

  // Buttons
  pinMode(PIN_UP, INPUT_PULLUP);
  pinMode(PIN_DN, INPUT_PULLUP);
  pinMode(PIN_SEL, INPUT_PULLUP);

  // ADC
  analogReadResolution(12);

  // LCD
  lcd.init();
  lcd.backlight();
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Voltage Protector");
  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  // Load saved settings
  prefs.begin("vprot", false);
  loadSettings();

  // Initial sensor readings
  v = analogRead(PIN_V) * 300.0 / 4095.0;
  i = analogRead(PIN_I) * 10.0 / 4095.0;

  // Startup cooldown
  state = 2;
  pending = false;
  coolStart = millis();

  updateLEDs();

  Serial.println();
  Serial.println("Voltage Protector ready.");
  Serial.println("Relay OFF during startup cooldown.");

  printSettings();
  printHelp();
}

// ---------- Main loop ----------
void loop() {
  readSensors();
  protection();
  buttons();
  showDisplay();
  readSerial();
  updateLEDs();
}
